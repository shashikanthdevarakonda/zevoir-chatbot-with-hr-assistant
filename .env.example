# Copy this file to ".env" (in the project root, next to app.py) and fill in
# your real values. Never commit the actual ".env" file — only this example.

# ---- Gmail SMTP (for real email sending) ----
# The Gmail account that will SEND the emails (can be any Gmail account you own).
GMAIL_ADDRESS=your_gmail_address@gmail.com
# An "App Password" (NOT your normal Gmail password) — see EMAIL_WHATSAPP_SETUP.md
GMAIL_APP_PASSWORD=your_16_character_app_password

# ---- Twilio (for real WhatsApp sending) ----
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio's WhatsApp Sandbox number — same for everyone during testing:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
